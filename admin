/* ============================================================
   DASHBOARD
============================================================ */

function updateDashboard(){

  document.getElementById("statClients").textContent =
    clients.length;

  document.getElementById("statProjects").textContent =
    projects.filter(
      p => p.status !== "completed"
    ).length;

  document.getElementById("statTasks").textContent =
    tasks.filter(
      t => !t.is_completed
    ).length;

  document.getElementById("statAccess").textContent =
    accessRequests.filter(
      a => a.status !== "completed"
    ).length;


  const projectBox =
    document.getElementById("dashboardProjects");

  if(!projects.length){

    projectBox.innerHTML =
      `<div class="empty">No projects yet.</div>`;

  }else{

    projectBox.innerHTML =
      projects.slice(0,6).map(p => {

        const client =
          clients.find(
            c => c.id === p.client_id
          );

        return `
          <div style="padding:13px 0;border-bottom:1px solid #edf2f7">

            <div style="display:flex;justify-content:space-between;gap:10px">

              <strong style="font-size:13px">
                ${escapeHtml(p.project_name || "Project")}
              </strong>

              <span class="badge badge-blue">
                ${Number(p.progress || 0)}%
              </span>

            </div>

            <div style="font-size:11px;color:var(--muted);margin:4px 0 8px">
              ${escapeHtml(client?.company_name || client?.full_name || "—")}
            </div>

            <div class="project-progress">
              <span style="width:${Number(p.progress || 0)}%"></span>
            </div>

          </div>
        `;

      }).join("");

  }


  const activityBox =
    document.getElementById("dashboardActivity");

  if(!activityLogs.length){

    activityBox.innerHTML =
      `<div class="empty">No activity yet.</div>`;

  }else{

    activityBox.innerHTML =
      activityLogs.slice(0,6).map(a => {

        return `
          <div class="activity-item">

            <div class="activity-dot"></div>

            <div>

              <div class="activity-text">
                ${escapeHtml(a.action || "Activity")}
              </div>

              <div class="activity-time">
                ${formatDateTime(a.created_at)}
              </div>

            </div>

          </div>
        `;

      }).join("");

  }

}


/* ============================================================
   COUNTS
============================================================ */

function updateCounts(){

  unreadMessages =
    messages.length;

  const pendingAccess =
    accessRequests.filter(
      a => a.status !== "completed"
    ).length;

  document.getElementById("accessNavCount").textContent =
    pendingAccess;

  document
    .getElementById("accessNavCount")
    .classList.toggle(
      "hidden",
      pendingAccess === 0
    );

  document.getElementById("messageNavCount").textContent =
    unreadMessages;

  document
    .getElementById("messageNavCount")
    .classList.toggle(
      "hidden",
      unreadMessages === 0
    );

}


/* ============================================================
   REALTIME
============================================================ */

function setupRealtime(){

  supabaseClient
    .channel("awsz-admin-realtime")

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"clients"
      },
      async () => {

        await loadClients();

        renderClients();

        updateDashboard();

        addBrowserNotification(
          "Client Update",
          "Client information changed."
        );

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"projects"
      },
      async () => {

        await loadProjects();

        renderProjects();

        updateDashboard();

        addBrowserNotification(
          "Project Update",
          "A project was updated."
        );

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"tasks"
      },
      async () => {

        await loadTasks();

        renderTasks();

        updateDashboard();

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"messages"
      },
      async payload => {

        await loadMessages();

        renderMessages();

        updateCounts();

        addBrowserNotification(
          "New Message",
          "A client message was received."
        );

        updateFaviconBadge(
          unreadMessages
        );

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"documents"
      },
      async () => {

        await loadDocuments();

        renderDocuments();

        addBrowserNotification(
          "New Document",
          "A project document was uploaded."
        );

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"access_requests"
      },
      async () => {

        await loadAccessRequests();

        renderAccess();

        updateCounts();

        addBrowserNotification(
          "Access Request",
          "A client access request changed."
        );

      }
    )

    .on(
      "postgres_changes",
      {
        event:"*",
        schema:"public",
        table:"activity_logs"
      },
      async () => {

        await loadActivity();

        renderActivity();

        updateDashboard();

      }
    )

    .subscribe();

}


/* ============================================================
   BROWSER NOTIFICATION + FAVICON
============================================================ */

function addBrowserNotification(
  title,
  body
){

  unreadNotifications++;

  updateNotificationUI();

  updateFaviconBadge(
    unreadNotifications
  );

}


function updateNotificationUI(){

  const dot =
    document.getElementById("notificationDot");

  const nav =
    document.getElementById("notificationNavCount");

  if(unreadNotifications > 0){

    dot.classList.remove("hidden");

    nav.textContent =
      unreadNotifications;

    nav.classList.remove("hidden");

  }else{

    dot.classList.add("hidden");

    nav.classList.add("hidden");

  }

}


function updateFaviconBadge(count){

  const canvas =
    document.createElement("canvas");

  canvas.width = 64;
  canvas.height = 64;

  const ctx =
    canvas.getContext("2d");

  ctx.fillStyle =
    "#246bce";

  ctx.beginPath();

  ctx.roundRect(
    4,
    4,
    56,
    56,
    14
  );

  ctx.fill();

  ctx.fillStyle =
    "#fff";

  ctx.font =
    "bold 30px Arial";

  ctx.textAlign =
    "center";

  ctx.textBaseline =
    "middle";

  ctx.fillText(
    "A",
    32,
    35
  );


  if(count > 0){

    const label =
      count > 99
      ? "99+"
      : String(count);

    ctx.fillStyle =
      "#c33d3d";

    ctx.beginPath();

    ctx.arc(
      49,
      15,
      14,
      0,
      Math.PI * 2
    );

    ctx.fill();

    ctx.fillStyle =
      "#fff";

    ctx.font =
      "bold 12px Arial";

    ctx.fillText(
      label,
      49,
      15
    );

  }


  const link =
    document.querySelector(
      "link[rel='icon']"
    );

  link.href =
    canvas.toDataURL("image/png");

}


