    return;
  }

  tbody.innerHTML =
    accessRequests.map(a => {

      const project =
        projects.find(
          p => String(p.id) === String(a.project_id)
        );

      return `
        <tr>

          <td>
            <strong>
              ${escapeHtml(a.system_name || "—")}
            </strong>
          </td>

          <td>
            ${escapeHtml(a.access_type || "—")}
          </td>

          <td>
            ${escapeHtml(project?.project_name || "—")}
          </td>

          <td>

            <span class="badge ${
              a.status === "completed"
              ? "badge-green"
              : "badge-amber"
            }">
              ${escapeHtml(a.status || "Pending")}
            </span>

          </td>

          <td>
            ${formatDate(a.requested_at)}
          </td>

          <td>

            <button
              class="action-btn"
              onclick="completeAccess('${a.id}')"
            >
              Complete
            </button>

          </td>

        </tr>
      `;

    }).join("");

}


async function completeAccess(id){

  const { error } =
    await supabaseClient
      .from("access_requests")
      .update({
        status:"completed",
        completed_at:new Date().toISOString()
      })
      .eq("id",id);

  if(error){

    alert(error.message);

    return;
  }

  await loadAccessRequests();

  renderAccess();

  updateCounts();

}


/* ============================================================
   DOCUMENTS
============================================================ */

async function loadDocuments(){

  const { data } =
    await supabaseClient
      .from("documents")
      .select("*")
      .order("created_at",{ascending:false});

  documents = data || [];

}


function renderDocuments(){

  const tbody =
    document.getElementById("documentsTable");

  if(!documents.length){

    tbody.innerHTML =
      `<tr>
        <td colspan="5">
          <div class="empty">
            No documents yet.
          </div>
        </td>
      </tr>`;

    return;
  }

  tbody.innerHTML =
    documents.map(d => {

      const project =
        projects.find(
          p => String(p.id) === String(d.project_id)
        );

      return `
        <tr>

          <td>
            <strong>
              ${escapeHtml(d.file_name || "Document")}
            </strong>
          </td>

          <td>
            ${escapeHtml(project?.project_name || "—")}
          </td>

          <td>
            ${escapeHtml(d.uploaded_by || "—")}
          </td>

          <td>
            ${formatDate(d.created_at)}
          </td>

          <td>

            ${
              d.file_url
              ?
              `<a
