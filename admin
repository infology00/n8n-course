    }

    const { error } =
      await supabaseClient
        .from("projects")
        .insert({

          client_id:clientId,

          project_name:name,

          description:description,

          quoted_price:
            price ? Number(price) : null,

          stage:"Onboarding",

          progress:0,

          status:status,

          start_date:start,

          expected_completion:end

        });

    if(error){

      alert(error.message);

      return;
    }

    closeModal("projectModal");

    document
      .getElementById("projectForm")
      .reset();

    await loadProjects();

    renderProjects();

    updateDashboard();

  });


