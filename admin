<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AWSZ Admin Portal</title>

<link rel="icon" href="data:image/svg+xml,
<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22>
<rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%23246bce%22/>
<text x=%2250%22 y=%2264%22 text-anchor=%22middle%22 font-size=%2250%22 font-family=%22Arial%22 font-weight=%22700%22 fill=%22white%22>A</text>
</svg>">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --cloud:#f4f8fc;
  --cloud2:#eaf2fa;
  --cloud3:#dceaf7;
  --blue:#246bce;
  --blue-dark:#123b70;
  --deep:#0b2850;
  --text:#20272e;
  --muted:#66778a;
  --line:#d8e4ef;
  --white:#fff;
  --green:#20855a;
  --green-bg:#eaf7f0;
  --amber:#b97918;
  --amber-bg:#fff5df;
  --red:#c33d3d;
  --red-bg:#fff0f0;
  --shadow:0 12px 35px rgba(18,59,112,.08);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:var(--cloud);
  color:var(--text);
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

/* LOGIN */

.login-screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:30px;
  background:
    radial-gradient(circle at 10% 10%,#e3f0ff 0,transparent 30%),
    radial-gradient(circle at 90% 90%,#dceafa 0,transparent 28%),
    var(--cloud);
}

.login-box{
  width:100%;
  max-width:450px;
  background:white;
  border:1px solid var(--line);
  border-radius:24px;
  padding:38px;
  box-shadow:var(--shadow);
}

.logo{
  width:52px;
  height:52px;
  border-radius:15px;
  background:var(--blue);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  font-size:22px;
  margin-bottom:20px;
}

.login-box h1{
  font-size:30px;
  color:var(--deep);
  margin-bottom:8px;
}

.login-box p{
  color:var(--muted);
  margin-bottom:28px;
}

.field{
  margin-bottom:17px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:7px;
}

.field input,
.field textarea,
.field select{
  width:100%;
  border:1px solid var(--line);
  border-radius:11px;
  padding:13px 14px;
  outline:none;
  background:white;
}

.field input:focus,
.field textarea:focus,
.field select:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(36,107,206,.08);
}

.primary-btn{
  border:0;
  background:var(--blue);
  color:white;
  padding:13px 18px;
  border-radius:11px;
  font-weight:700;
  transition:.2s;
}

.primary-btn:hover{
  background:var(--blue-dark);
  transform:translateY(-1px);
}

.login-error{
  background:var(--red-bg);
  color:var(--red);
  padding:12px;
  border-radius:10px;
  margin-bottom:16px;
  font-size:14px;
}

/* APP */

.app{
  min-height:100vh;
  display:flex;
}

.sidebar{
  width:250px;
  background:white;
  border-right:1px solid var(--line);
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  padding:22px 16px;
  z-index:50;
  overflow-y:auto;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  padding:5px 10px 25px;
}

.brand-mark{
  width:40px;
  height:40px;
  border-radius:12px;
  background:var(--blue);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

.brand strong{
  color:var(--deep);
  font-size:17px;
}

.brand small{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-top:2px;
}

.nav-title{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:1px;
  color:#94a3b8;
  font-weight:800;
  padding:15px 12px 7px;
}

.nav-btn{
  width:100%;
  display:flex;
  align-items:center;
  gap:11px;
  border:0;
  background:transparent;
  padding:11px 12px;
  border-radius:10px;
  color:#506174;
  text-align:left;
  margin-bottom:3px;
}

.nav-btn:hover,
.nav-btn.active{
  background:var(--cloud2);
  color:var(--blue-dark);
}

.nav-icon{
  width:22px;
  text-align:center;
}

.nav-count{
  margin-left:auto;
  background:var(--red);
  color:white;
  min-width:20px;
  height:20px;
  border-radius:20px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:10px;
  font-weight:800;
}

.main{
  margin-left:250px;
  width:calc(100% - 250px);
}

.topbar{
  height:74px;
  background:rgba(255,255,255,.94);
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 30px;
  position:sticky;
  top:0;
  z-index:30;
  backdrop-filter:blur(10px);
}

.top-title h2{
  color:var(--deep);
  font-size:20px;
}

.top-title span{
  font-size:12px;
  color:var(--muted);
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.icon-btn{
  width:40px;
  height:40px;
  border:1px solid var(--line);
  border-radius:11px;
  background:white;
  position:relative;
}

.notification-dot{
  position:absolute;
  right:5px;
  top:4px;
  width:9px;
  height:9px;
  border-radius:50%;
  background:var(--red);
  border:2px solid white;
}

.admin-email{
  background:var(--cloud);
  padding:10px 13px;
  border-radius:10px;
  font-size:12px;
  color:var(--muted);
}

.content{
  padding:30px;
  max-width:1700px;
  margin:auto;
}

/* COMMON */

.page{
  display:none;
}

.page.active{
  display:block;
}

.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
  margin-bottom:25px;
}

.page-head h1{
  color:var(--deep);
  font-size:28px;
}

.page-head p{
  color:var(--muted);
  margin-top:5px;
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:17px;
  box-shadow:0 7px 22px rgba(18,59,112,.035);
}

.card-pad{
  padding:20px;
}

.grid{
  display:grid;
  gap:18px;
}

.grid-4{
  grid-template-columns:repeat(4,1fr);
}

.grid-3{
  grid-template-columns:repeat(3,1fr);
}

.grid-2{
  grid-template-columns:repeat(2,1fr);
}

.stat{
  padding:20px;
}

.stat-label{
  color:var(--muted);
  font-size:13px;
  font-weight:600;
}

.stat-number{
  font-size:30px;
  font-weight:800;
  color:var(--deep);
  margin-top:8px;
}

.stat-bottom{
  margin-top:9px;
  font-size:12px;
  color:var(--muted);
}

.section-title{
  font-size:17px;
  color:var(--deep);
  font-weight:800;
  margin-bottom:15px;
}

.table-wrap{
  overflow:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th{
  text-align:left;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:#8492a3;
  padding:13px 14px;
  border-bottom:1px solid var(--line);
  white-space:nowrap;
}

td{
  padding:15px 14px;
  border-bottom:1px solid #edf2f7;
  font-size:13px;
}

tr:last-child td{
  border-bottom:0;
}

.badge{
  display:inline-flex;
  align-items:center;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:700;
}

.badge-green{
  background:var(--green-bg);
  color:var(--green);
}

.badge-blue{
  background:#edf4ff;
  color:var(--blue);
}

.badge-amber{
  background:var(--amber-bg);
  color:var(--amber);
}

.badge-red{
  background:var(--red-bg);
  color:var(--red);
}

.action-btn{
  border:1px solid var(--line);
  background:white;
  border-radius:8px;
  padding:7px 10px;
  font-size:11px;
}

.action-btn:hover{
  background:var(--cloud);
}

.empty{
  padding:35px;
  text-align:center;
  color:var(--muted);
}

/* DASHBOARD */

.welcome{
  padding:27px;
  border-radius:19px;
  background:linear-gradient(135deg,#eaf3ff,#f7fbff);
  border:1px solid #d5e5f6;
  margin-bottom:20px;
}

.welcome h1{
  color:var(--deep);
  font-size:26px;
}

.welcome p{
  color:var(--muted);
  margin-top:7px;
}

.activity-item{
  display:flex;
  gap:13px;
  padding:14px 0;
  border-bottom:1px solid #edf2f7;
}

.activity-item:last-child{
  border-bottom:0;
}

.activity-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:var(--blue);
  margin-top:5px;
  flex:none;
}

.activity-text{
  font-size:13px;
}

.activity-time{
  font-size:11px;
  color:#94a3b8;
  margin-top:4px;
}

/* SEARCH */

.search{
  width:300px;
  border:1px solid var(--line);
  background:white;
  padding:11px 13px;
  border-radius:10px;
  outline:none;
}

/* MODAL */

.modal-bg{
  position:fixed;
  inset:0;
  background:rgba(11,40,80,.35);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:100;
}

.modal-bg.show{
  display:flex;
}

.modal{
  width:100%;
  max-width:700px;
  max-height:90vh;
  overflow:auto;
  background:white;
  border-radius:20px;
  box-shadow:0 30px 80px rgba(0,0,0,.18);
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 22px;
  border-bottom:1px solid var(--line);
}

.modal-head h3{
  color:var(--deep);
}

.close-btn{
  border:0;
  background:var(--cloud);
  width:34px;
  height:34px;
  border-radius:9px;
}

.modal-body{
  padding:22px;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
}

.full{
  grid-column:1/-1;
}

.modal-footer{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  padding:18px 22px;
  border-top:1px solid var(--line);
}

/* NOTIFICATIONS */

.notification-panel{
  position:fixed;
  top:70px;
  right:25px;
  width:390px;
  max-height:600px;
  overflow:auto;
  background:white;
  border:1px solid var(--line);
  border-radius:17px;
  box-shadow:0 20px 60px rgba(18,59,112,.18);
  z-index:90;
  display:none;
}

.notification-panel.show{
  display:block;
}

.notification-head{
  padding:17px;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
}

.notification{
  padding:15px 17px;
  border-bottom:1px solid #edf2f7;
}

.notification.unread{
  background:#f5f9ff;
}

.notification strong{
  font-size:13px;
  color:var(--deep);
}

.notification p{
  color:var(--muted);
  font-size:12px;
  margin-top:4px;
}

.notification small{
  color:#94a3b8;
  font-size:10px;
}

/* PROJECT */

.project-progress{
  width:100%;
  height:8px;
  background:#edf2f7;
  border-radius:10px;
  overflow:hidden;
}

.project-progress span{
  display:block;
  height:100%;
  background:var(--blue);
  border-radius:10px;
}

.stage-line{
  display:flex;
  align-items:center;
  overflow:auto;
  padding:15px 0;
}

.stage{
  display:flex;
  align-items:center;
  white-space:nowrap;
}

.stage-circle{
  width:27px;
  height:27px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#edf2f7;
  color:#8290a0;
  font-size:10px;
  font-weight:800;
}

.stage.active .stage-circle{
  background:var(--blue);
  color:white;
}

.stage.done .stage-circle{
  background:var(--green);
  color:white;
}

.stage-linebar{
  width:35px;
  height:2px;
  background:#dce5ef;
}

.stage.done + .stage-linebar{
  background:var(--green);
}

/* CHAT */

.message{
  display:flex;
  margin-bottom:13px;
}

.message.admin{
  justify-content:flex-end;
}

.message-bubble{
  max-width:75%;
  background:var(--cloud);
  border-radius:13px;
  padding:11px 13px;
  font-size:13px;
}

.message.admin .message-bubble{
  background:#e8f1ff;
}

.message-meta{
  font-size:10px;
  color:#94a3b8;
  margin-top:5px;
}

/* MOBILE */

.mobile-menu{
  display:none;
}

@media(max-width:1050px){
  .grid-4{
    grid-template-columns:repeat(2,1fr);
  }

  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .mobile-menu{
    display:block;
    border:1px solid var(--line);
    background:white;
    width:40px;
    height:40px;
    border-radius:10px;
  }
}

@media(max-width:700px){
  .content{
    padding:18px;
  }

  .topbar{
    padding:0 15px;
  }

  .admin-email{
    display:none;
  }

  .grid-4,
  .grid-3,
  .grid-2,
  .form-grid{
    grid-template-columns:1fr;
  }

  .page-head{
    flex-direction:column;
  }

  .search{
    width:100%;
  }

  .notification-panel{
    left:15px;
    right:15px;
    width:auto;
  }

  .login-box{
    padding:25px;
  }
}
</style>
</head>

<body>

<!-- LOGIN -->

<section id="loginScreen" class="login-screen">

  <div class="login-box">

    <div class="logo">A</div>

    <h1>AWSZ Admin</h1>

    <p>Project & Client Management Portal</p>

    <div id="loginError" class="login-error hidden"></div>

    <form id="loginForm">

      <div class="field">
        <label>Email</label>
        <input
          id="loginEmail"
          type="email"
          placeholder="admin@example.com"
          required
        >
      </div>

      <div class="field">
        <label>Password</label>
        <input
          id="loginPassword"
          type="password"
          placeholder="••••••••"
          required
        >
      </div>

      <button class="primary-btn" style="width:100%" type="submit">
        Sign In to Admin
      </button>

    </form>

  </div>

</section>


<!-- APP -->

<div id="app" class="app hidden">

  <!-- SIDEBAR -->

  <aside id="sidebar" class="sidebar">

    <div class="brand">
      <div class="brand-mark">A</div>

      <div>
        <strong>AWSZ</strong>
        <small>Admin Portal</small>
      </div>
    </div>


    <div class="nav-title">Management</div>

    <button class="nav-btn active" data-page="dashboard">
      <span class="nav-icon">⌂</span>
      Dashboard
    </button>

    <button class="nav-btn" data-page="clients">
      <span class="nav-icon">◉</span>
      Clients
    </button>

    <button class="nav-btn" data-page="projects">
      <span class="nav-icon">▣</span>
      Projects
    </button>

    <button class="nav-btn" data-page="tasks">
      <span class="nav-icon">✓</span>
      Tasks
    </button>

    <button class="nav-btn" data-page="messages">
      <span class="nav-icon">✉</span>
      Messages
      <span id="messageNavCount" class="nav-count hidden">0</span>
    </button>

    <button class="nav-btn" data-page="access">
      <span class="nav-icon">🔐</span>
      Access Requests
      <span id="accessNavCount" class="nav-count hidden">0</span>
    </button>

    <button class="nav-btn" data-page="documents">
      <span class="nav-icon">▤</span>
      Documents
    </button>


    <div class="nav-title">Finance</div>

    <button class="nav-btn" data-page="invoices">
      <span class="nav-icon">$</span>
      Invoices
    </button>


    <div class="nav-title">System</div>

    <button class="nav-btn" data-page="notifications">
      <span class="nav-icon">🔔</span>
      Notifications
      <span id="notificationNavCount" class="nav-count hidden">0</span>
    </button>

    <button class="nav-btn" data-page="activity">
      <span class="nav-icon">◷</span>
      Activity Logs
    </button>

    <button class="nav-btn" data-page="settings">
      <span class="nav-icon">⚙</span>
      Settings
    </button>

    <button id="logoutBtn" class="nav-btn" style="margin-top:20px">
      <span class="nav-icon">↪</span>
      Logout
    </button>

  </aside>


  <!-- MAIN -->

  <main class="main">

    <header class="topbar">

      <div style="display:flex;align-items:center;gap:10px">

        <button id="mobileMenu" class="mobile-menu">☰</button>

        <div class="top-title">
          <h2 id="pageTitle">Dashboard</h2>
          <span>AWSZ Operations Control Center</span>
        </div>

      </div>


      <div class="top-actions">

        <button id="notificationBtn" class="icon-btn">
          🔔
          <span id="notificationDot" class="notification-dot hidden"></span>
        </button>

        <div id="adminEmail" class="admin-email">
          Admin
        </div>

      </div>

    </header>


    <!-- NOTIFICATION PANEL -->

    <div id="notificationPanel" class="notification-panel">

      <div class="notification-head">

        <strong>Notifications</strong>

        <button
          id="markNotificationsRead"
          class="action-btn"
        >
          Mark all read
        </button>

      </div>

      <div id="notificationList"></div>

    </div>


    <div class="content">


      <!-- DASHBOARD -->

      <section id="page-dashboard" class="page active">

        <div class="welcome">

          <h1>Welcome back, Sajjad.</h1>

          <p>
            Manage clients, projects, tasks, messages, documents and invoices from one place.
          </p>

        </div>


        <div class="grid grid-4">

          <div class="card stat">
            <div class="stat-label">Total Clients</div>
            <div id="statClients" class="stat-number">0</div>
            <div class="stat-bottom">Registered accounts</div>
          </div>

          <div class="card stat">
            <div class="stat-label">Active Projects</div>
            <div id="statProjects" class="stat-number">0</div>
            <div class="stat-bottom">Current projects</div>
          </div>

          <div class="card stat">
            <div class="stat-label">Pending Tasks</div>
            <div id="statTasks" class="stat-number">0</div>
            <div class="stat-bottom">Tasks waiting</div>
          </div>

          <div class="card stat">
            <div class="stat-label">Access Requests</div>
            <div id="statAccess" class="stat-number">0</div>
            <div class="stat-bottom">Need attention</div>
          </div>

        </div>


        <div style="height:20px"></div>


        <div class="grid grid-2">

          <div class="card card-pad">

            <div class="section-title">
              Recent Projects
            </div>

            <div id="dashboardProjects">
              <div class="empty">Loading...</div>
            </div>

          </div>


          <div class="card card-pad">

            <div class="section-title">
              Recent Activity
            </div>

            <div id="dashboardActivity">
              <div class="empty">Loading...</div>
            </div>

          </div>

        </div>

      </section>


      <!-- CLIENTS -->

      <section id="page-clients" class="page">

        <div class="page-head">

          <div>
            <h1>Clients</h1>
            <p>Manage registered client accounts.</p>
          </div>

          <input
            id="clientSearch"
            class="search"
            placeholder="Search clients..."
          >

        </div>


        <div class="card">

          <div class="table-wrap">

            <table>

              <thead>
                <tr>
                  <th>Client</th>
                  <th>Company</th>
                  <th>Email</th>
                  <th>Projects</th>
                  <th>Created</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody id="clientsTable"></tbody>

            </table>

          </div>

        </div>

      </section>


      <!-- PROJECTS -->

      <section id="page-projects" class="page">

        <div class="page-head">

          <div>
            <h1>Projects</h1>
            <p>Create and manage every client project.</p>
          </div>

          <button id="newProjectBtn" class="primary-btn">
            + New Project
          </button>

        </div>


