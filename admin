const SUPABASE_URL =
  "https://ausocdplliuftdqxbvwa.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_MOXjixlgTPDBvrD3nZP81Q_9n30a-et";

const supabaseClient =
  supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/* ============================================================
   STATE
============================================================ */

let currentUser = null;

let clients = [];
let projects = [];
let tasks = [];
let messages = [];
let documents = [];
let accessRequests = [];
let activityLogs = [];

let unreadMessages = 0;
let unreadNotifications = 0;


/* ============================================================
   LOGIN
============================================================ */

document
  .getElementById("loginForm")
  .addEventListener("submit", async function(e){

    e.preventDefault();

    const email =
      document.getElementById("loginEmail").value.trim();

    const password =
      document.getElementById("loginPassword").value;

    const errorBox =
      document.getElementById("loginError");

    errorBox.classList.add("hidden");

    const { data, error } =
      await supabaseClient.auth.signInWithPassword({
        email,
        password
      });

    if(error){

      errorBox.textContent = error.message;

      errorBox.classList.remove("hidden");

      return;
    }

    currentUser = data.user;

    await verifyAdmin();

  });


/* ============================================================
   VERIFY ADMIN
============================================================ */

async function verifyAdmin(){

  if(!currentUser){

    showLogin();

    return;
  }

  const { data, error } =
    await supabaseClient
      .from("user_roles")
      .select("role")
      .eq("user_id", currentUser.id)
      .maybeSingle();

  if(
    error ||
    !data ||
    data.role !== "admin"
  ){

    await supabaseClient.auth.signOut();

    const errorBox =
      document.getElementById("loginError");

    errorBox.textContent =
      "This account does not have administrator access.";

    errorBox.classList.remove("hidden");

    showLogin();

    return;
  }

  showApp();

  document.getElementById("adminEmail").textContent =
    currentUser.email || "Admin";

  document.getElementById("settingsEmail").textContent =
    currentUser.email || "Admin";

  await loadAll();

  setupRealtime();

}


/* ============================================================
   AUTH STATE
============================================================ */

supabaseClient.auth.onAuthStateChange(
  async (event, session) => {

    if(
      event === "SIGNED_OUT"
    ){

      showLogin();

      return;
    }

    if(
      session &&
      !currentUser
    ){

      currentUser = session.user;

      await verifyAdmin();

    }

  }
);


/* ============================================================
   SHOW LOGIN / APP
============================================================ */

function showLogin(){

  document
    .getElementById("loginScreen")
    .classList.remove("hidden");

  document
    .getElementById("app")
    .classList.add("hidden");

}

function showApp(){

  document
    .getElementById("loginScreen")
    .classList.add("hidden");

  document
    .getElementById("app")
    .classList.remove("hidden");

}


/* ============================================================
   LOAD ALL
============================================================ */

async function loadAll(){

  await Promise.all([
    loadClients(),
    loadProjects(),
    loadTasks(),
    loadMessages(),
    loadDocuments(),
    loadAccessRequests(),
    loadActivity()
  ]);

  updateDashboard();

  renderClients();
  renderProjects();
  renderTasks();
  renderMessages();
  renderAccess();
  renderDocuments();
  renderActivity();

  updateCounts();

}


/* ============================================================
   CLIENTS
============================================================ */

async function loadClients(){

  const { data } =
    await supabaseClient
      .from("clients")
      .select("*")
      .order("created_at",{ascending:false});

  clients = data || [];

}


function renderClients(
  search = ""
){

  const tbody =
    document.getElementById("clientsTable");

  const term =
    search.toLowerCase();

  const filtered =
    clients.filter(c =>
      `${c.full_name || ""} ${c.company_name || ""} ${c.email || ""}`
      .toLowerCase()
      .includes(term)
    );

  if(!filtered.length){

    tbody.innerHTML =
      `<tr>
        <td colspan="6">
          <div class="empty">No clients found.</div>
        </td>
      </tr>`;

    return;
  }

  tbody.innerHTML =
    filtered.map(client => {

      const projectCount =
        projects.filter(
          p => p.client_id === client.id
        ).length;

      return `
        <tr>

          <td>
            <strong>${escapeHtml(client.full_name || "Unnamed")}</strong>
          </td>

          <td>
            ${escapeHtml(client.company_name || "—")}
          </td>

          <td>
            ${escapeHtml(client.email || "—")}
          </td>

          <td>
            <span class="badge badge-blue">
              ${projectCount}
            </span>
          </td>

          <td>
            ${formatDate(client.created_at)}
          </td>

          <td>

            <button
              class="action-btn"
              onclick="viewClient('${client.id}')"
            >
              View
            </button>

          </td>

        </tr>
      `;

    }).join("");

}


document
  .getElementById("clientSearch")
  .addEventListener("input", function(){

    renderClients(this.value);

  });


function viewClient(id){

  const client =
    clients.find(c => c.id === id);

  if(!client) return;

  const clientProjects =
    projects.filter(
      p => p.client_id === id
    );

  alert(
`CLIENT

Name: ${client.full_name || "—"}
Company: ${client.company_name || "—"}
Email: ${client.email || "—"}
Phone: ${client.phone || "—"}

Projects: ${clientProjects.length}`
  );

}


/* ============================================================
   PROJECTS
============================================================ */

async function loadProjects(){

  const { data } =
    await supabaseClient
      .from("projects")
      .select("*")
      .order("created_at",{ascending:false});

  projects = data || [];

}


function renderProjects(){

  const tbody =
    document.getElementById("projectsTable");

  if(!projects.length){

    tbody.innerHTML =
      `<tr>
        <td colspan="6">
          <div class="empty">No projects yet.</div>
        </td>
      </tr>`;

    return;
  }

  tbody.innerHTML =
    projects.map(project => {

      const client =
        clients.find(
          c => c.id === project.client_id
        );

      const progress =
        Number(project.progress || 0);

      return `
        <tr>

          <td>
            <strong>
              ${escapeHtml(project.project_name || "Untitled")}
            </strong>
          </td>

          <td>
            ${escapeHtml(client?.company_name || client?.full_name || "—")}
          </td>

          <td>
            <span class="badge badge-blue">
              ${escapeHtml(project.stage || "Onboarding")}
            </span>
          </td>

          <td style="min-width:130px">

            <div style="font-size:11px;margin-bottom:5px">
              ${progress}%
            </div>

            <div class="project-progress">
              <span style="width:${progress}%"></span>
            </div>

          </td>

          <td>
            <span class="badge ${
              project.status === "completed"
              ? "badge-green"
              : project.status === "on_hold"
              ? "badge-amber"
              : "badge-blue"
            }">
              ${escapeHtml(project.status || "active")}
            </span>
          </td>

          <td>

            <button
              class="action-btn"
              onclick="viewProject('${project.id}')"
            >
              Open
            </button>

          </td>

        </tr>
      `;

    }).join("");

}


function viewProject(id){

  const p =
    projects.find(
      x => String(x.id) === String(id)
    );

  if(!p) return;

  const taskCount =
    tasks.filter(
      t => String(t.project_id) === String(p.id)
    ).length;

  const completed =
    tasks.filter(
      t =>
        String(t.project_id) === String(p.id) &&
        t.is_completed
    ).length;

  alert(
`PROJECT

${p.project_name || "Untitled"}

Stage:
${p.stage || "Onboarding"}

Progress:
${p.progress || 0}%

Status:
${p.status || "active"}

Tasks:
${completed}/${taskCount}

Brief:
${p.description || "No project brief yet."}`
  );

}


/* ============================================================
   CREATE PROJECT
============================================================ */

document
  .getElementById("newProjectBtn")
  .addEventListener("click",function(){

    populateClientSelect("projectClient");

    document
      .getElementById("projectModal")
      .classList.add("show");

  });


document
  .getElementById("projectForm")
  .addEventListener("submit",async function(e){

    e.preventDefault();

    const clientId =
      document.getElementById("projectClient").value;

    const name =
      document.getElementById("projectName").value.trim();

    const description =
      document.getElementById("projectDescription").value.trim();

    const price =
      document.getElementById("projectPrice").value;

    const status =
      document.getElementById("projectStatus").value;

    const start =
