/* ============================================================
   MESSAGES
============================================================ */

async function loadMessages(){

  const { data } =
    await supabaseClient
      .from("messages")
      .select("*")
      .order("created_at",{ascending:false});

  messages = data || [];

}


function renderMessages(){

  const box =
    document.getElementById("messageProjects");

  const projectIds =
    [...new Set(
      messages.map(m => String(m.project_id))
    )];

  if(!projectIds.length){

    box.innerHTML =
      `<div class="empty">No messages yet.</div>`;

    return;
  }

  box.innerHTML =
    projectIds.map(id => {

      const project =
        projects.find(
          p => String(p.id) === id
        );

      const count =
        messages.filter(
          m => String(m.project_id) === id
        ).length;

      return `
        <button
          class="nav-btn"
          style="border:1px solid var(--line);margin-bottom:7px"
          onclick="openMessageThread('${id}')"
        >
          <span class="nav-icon">✉</span>

          <span style="flex:1">
            ${escapeHtml(project?.project_name || "Project")}
          </span>

          <span class="badge badge-blue">
            ${count}
          </span>

        </button>
      `;

    }).join("");

}


function openMessageThread(projectId){

  const thread =
    messages
      .filter(
        m => String(m.project_id) === String(projectId)
      )
      .sort(
        (a,b) =>
          new Date(a.created_at) -
          new Date(b.created_at)
      );

  const box =
    document.getElementById("messageThread");

  box.innerHTML =
    thread.map(m => {

      const admin =
        m.sender_type === "admin";

      return `
        <div class="message ${admin ? "admin" : ""}">

          <div>

            <div class="message-bubble">

              ${escapeHtml(m.message || "")}

              <div class="message-meta">
                ${escapeHtml(m.sender_name || m.sender_type || "User")}
                ·
                ${formatDateTime(m.created_at)}
              </div>

            </div>

          </div>

        </div>
      `;

    }).join("");

}


